---
import Base from '../layouts/Base.astro';
---
<Base title="Globoknot" description="A geography quiz: countries, capitals, flags and languages. Type your answers; typos are forgiven.">
  <main class="wrap">
    <section id="start" class="screen start">
      <canvas id="globe" class="globe" aria-hidden="true"></canvas>
      <h1 class="hero">The world,<br /><em>tied together.</em></h1>
      <div class="modes">
        <button class="mode primary" data-mode="mixed" type="button" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3c-3 3-3 15 0 18M12 3c3 3 3 15 0 18M3.5 9h17M3.5 15h17" /></svg>
          <span>Mixed</span>
        </button>
        <button class="mode" data-mode="map" type="button" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14" /></svg>
          <span>Map</span>
        </button>
        <button class="mode" data-mode="capitals" type="button" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          <span>Capitals</span>
        </button>
        <button class="mode" data-mode="flags" type="button" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5" /></svg>
          <span>Flags</span>
        </button>
        <button class="mode" data-mode="languages" type="button" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z" /><path d="M8 9h8M8 12h5" /></svg>
          <span>Languages</span>
        </button>
      </div>
      <p class="fine">10 questions · typos forgiven</p>
    </section>

    <section id="play" class="screen play" hidden>
      <div class="bar">
        <div id="progress" class="progress" aria-hidden="true"></div>
        <span id="clock" class="clock" aria-label="Time">0:00</span>
      </div>
      <div id="card" class="card">
        <div id="media" class="media" data-kind="none">
          <svg id="map" class="map" role="img" aria-label="Map with one country highlighted"></svg>
          <img id="flag" class="flag" alt="A flag to name" />
        </div>
        <h2 id="prompt" class="prompt"></h2>
        <form id="answer-form" class="answer" autocomplete="off">
          <input id="answer" type="text" autocapitalize="words" autocorrect="off" spellcheck="false" enterkeyhint="go" aria-label="Your answer" />
          <button class="go" type="submit" aria-label="Answer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </form>
        <div id="choices" class="choices" hidden></div>
        <p id="reveal" class="reveal" aria-live="polite"></p>
      </div>
      <div class="under">
        <button id="skip" class="ghost" type="button">Skip <kbd>Esc</kbd></button>
      </div>
      <ol id="log" class="log" aria-label="Your answers"></ol>
    </section>

    <section id="results" class="screen results" hidden>
      <p id="score" class="score"></p>
      <p id="time" class="time"></p>
      <ul id="misses" class="misses" aria-label="Missed"></ul>
      <div class="actions">
        <button id="again" class="btn primary" type="button">Again</button>
        <button id="home" class="btn" type="button">Modes</button>
      </div>
    </section>
  </main>
</Base>

<script>
  import '../scripts/app.ts';
</script>
