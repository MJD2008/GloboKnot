// Cloudflare Workers settings: the site (everything Astro builds into dist/) and, for /api/ only, a small server
// (worker/): The Gordian Knot's board, and the players on the site now. Steps: docs/DEPLOY.md
{
  "name": "globoknot",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  // Only /api/ wakes the Worker; every other request is a static file, served without it.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // The Gordian Knot's answer key, made from the data before every deploy (scripts/build-answers.mjs).
  "build": { "command": "node scripts/build-answers.mjs" },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "Board" },
      { "name": "LIVE", "class_name": "Live" }
    ]
  },
  "exports": {
    "Board": { "type": "durable-object", "storage": "sqlite" },
    "Live": { "type": "durable-object", "storage": "sqlite" }
  }
}
